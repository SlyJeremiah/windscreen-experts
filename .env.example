# Copy to .env and fill in real values

# Django
SECRET_KEY=your-secret-key-here
DEBUG=False

# PostgreSQL (Supabase)
# On Vercel use the Supabase *connection pooler* URL (Project Settings -> Database ->
# Connection string -> "Transaction pooler"). The direct db.<project>.supabase.co host
# is IPv6-only and hangs on Vercel.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# Email – Gmail SMTP
EMAIL_HOST_USER=munashe@windowscreens.co.zw
EMAIL_HOST_PASSWORD=your-gmail-app-password
ADMIN_EMAIL=munashe@windowscreens.co.zw

# Supabase Storage (media uploads: gallery photos/videos)
# Required on Vercel - its filesystem is read-only, so uploads fail without this.
USE_SUPABASE_STORAGE=True
SUPABASE_STORAGE_KEY=your-s3-access-key-id
SUPABASE_STORAGE_SECRET=your-s3-secret-access-key

# Google Analytics
GA_MEASUREMENT_ID=G-XXXXXXXXXX
